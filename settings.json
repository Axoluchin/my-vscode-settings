{
  "workbench.iconTheme": "file-icons",
  "editor.suggestSelection": "first",
  "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
  "terminal.integrated.fontFamily": "'MesloLGS NF'",
  "editor.fontFamily": "'FiraCode NF', 'firaCode Nerd Font', 'Input Mono', 'MesloLGS NF', Consolas, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.linkedEditing": true,
  "security.workspace.trust.untrustedFiles": "open",
  "diffEditor.renderSideBySide": false,
  "editor.guides.bracketPairs": true,
  "editor.guides.bracketPairsHorizontal": "active",
  "editor.guides.highlightActiveBracketPair": true,
  "editor.guides.highlightActiveIndentation": true,
  "editor.guides.indentation": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "files.exclude": {
    "**/.classpath": true,
    "**/.project": true,
    "**/.settings": true,
    "**/.factorypath": true
  },
  "typescript.updateImportsOnFileMove.enabled": "always",
  "terminal.integrated.minimumContrastRatio": 0,
  "git.confirmSync": false,
  "explorer.confirmDelete": false,
  "explorer.fileNesting.patterns": {
    "pubspec.yaml": "pubspec.lock,pubspec_overrides.yaml,.packages,.flutter-plugins,.flutter-plugins-dependencies,.metadata",
    "*.dart": "${capture}.g.dart"
  },
  "workbench.list.smoothScrolling": true,
  "editor.fastScrollSensitivity": 1,
  "editor.smoothScrolling": false,
  "editor.stickyScroll.enabled": true,
  "editor.defaultFormatter": "exceptionptr.vscode-prettier-eslint",
  "editor.accessibilitySupport": "off",
  "diffEditor.ignoreTrimWhitespace": false,
  "terminal.integrated.customGlyphs": false,
  "settingsSync.ignoredSettings": [
    "terminal.integrated.fontFamily",
    "editor.fontFamily"
  ],
  "terminal.integrated.fontSize": 13,
  "workbench.productIconTheme": "icons-carbon",
  "errorLens.excludeBySource": ["ts(2322)"],
  "vsicons.dontShowNewVersionMessage": true,
  "githubPullRequests.createOnPublishBranch": "never",
  "editor.minimap.enabled": false,
  "editor.minimap.autohide": true,
  "workbench.sideBar.location": "right",
  "window.nativeTabs": true,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorSurroundingLines": 5,
  "editor.cursorSurroundingLinesStyle": "default",
  "editor.occurrencesHighlight": "singleFile",
  "editor.wordWrap": "on",
  "editor.formatOnType": true,
  "workbench.colorCustomizations": {
    "editorCursor.background": "#9f8107",
    "editorCursor.foreground": "#ab953a"
  },
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.selectionHighlight": true,
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.suggestSelection": "first",
    "editor.tabCompletion": "onlySnippets",
    "editor.wordBasedSuggestions": "allDocuments"
  },
  "svg.preview.mode": "img",
  "security.workspace.trust.banner": "never",
  "security.workspace.trust.emptyWindow": true,
  "security.workspace.trust.enabled": false,
  "security.workspace.trust.startupPrompt": "never",
  "editor.unicodeHighlight.allowedCharacters": {
    "´": true
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.fixAll.tslint": "explicit",
    "source.fixAll.stylelint": "explicit"
  },
  "json.schemas": [],
  "editor.defaultColorDecorators": "auto",
  "workbench.layoutControl.enabled": false,
  "window.menuBarVisibility": "compact",
  "window.commandCenter": false,
  "workbench.colorTheme": "Vitesse Dark Soft",
  "workbench.activityBar.location": "top",
  "playwright.showTrace": false,
  "terminal.integrated.stickyScroll.enabled": true,
  "workbench.tree.enableStickyScroll": true,
  "notebook.stickyScroll.enabled": true,
  "settingsSync.ignoredExtensions": [
    "ms-dotnettools.csdevkit"
  ],
  "editor.formatOnSave": true,
  "window.zoomLevel": 1,
  "[astro]": {
    "editor.defaultFormatter": "astro-build.astro-vscode"
  },
  "notebook.compactView": false,
  "cSpell.language": "en,es-ES,es",
  "cSpell.userWords": [
    "apod",
    "astrojs",
    "Backoffice",
    "CDMX",
    "clabe",
    "collatz",
    "Damián",
    "graphik",
    "Graphik",
    "hookform",
    "Huchín",
    "iconoir",
    "keyframes",
    "mingcute",
    "mubi",
    "Mubi",
    "nextui",
    "notistack",
    "nowrap",
    "nums",
    "orbi",
    "Pressable",
    "spei",
    "SPEI",
    "spotify",
    "strapi",
    "sublink",
    "tailwindcss",
    "tauri",
    "webp"
  ],
  "githubPullRequests.pullBranch": "never",
  "markdown-preview-enhanced.previewTheme": "atom-dark.css",
  "liveServer.settings.donotShowInfoMsg": true,
  "cSpell.enableFiletypes": ["astro", "mdx"],
  "redhat.telemetry.enabled": false,
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "[java]": {
    "editor.defaultFormatter": "redhat.java"
  },
  "playwright.reuseBrowser": false,
  "supermaven.enableFixWithSupermaven": false,
  "remote.portsAttributes": {
    "5173": {
      "protocol": "https"
    }
  },
  "vs-code-prettier-eslint.prettierLast": true
}
